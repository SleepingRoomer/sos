---
// Formulaire de contact : envoi par e-mail via Web3Forms (pas de serveur à gérer).
// Le motif peut être prérempli avec l'adresse contact/?motif=presse
// Si l'envoi échoue (ou si la clé n'est pas encore renseignée), la personne peut
// ouvrir son appli mail avec le message déjà rédigé, ou copier le message.
import { CONTACT, SITE } from '../config';
import { url } from '../utils';
import Icone from './Icone.astro';
const merci = new URL(url('contact/merci'), Astro.site).toString();
---

<form
  class="contact-form"
  id="formulaire"
  action={CONTACT.envoi}
  method="POST"
  data-contact
  data-envoi={CONTACT.envoi}
  data-cle={CONTACT.cle}
  data-email={SITE.email}
>
  <input type="hidden" name="access_key" value={CONTACT.cle} />
  <input type="hidden" name="subject" value="[Site SOS] Nouveau message" data-sujet />
  <input type="hidden" name="from_name" value="Site Soigner ou Saigner" />
  <input type="hidden" name="redirect" value={merci} />
  <input type="checkbox" name="botcheck" class="piege" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <div class="champ">
    <label for="motif">Objet de votre message</label>
    <select id="motif" name="Motif" required>
      {CONTACT.motifs.map((m) => <option value={m.label} data-id={m.id}>{m.label}</option>)}
    </select>
  </div>

  <div class="champs-2">
    <div class="champ">
      <label for="nom">Nom et prénom (ou pseudo)</label>
      <input id="nom" name="Nom" type="text" required autocomplete="name" />
    </div>
    <div class="champ">
      <label for="email">E-mail</label>
      <input id="email" name="email" type="email" required autocomplete="email" />
    </div>
  </div>

  <div class="champ">
    <label for="structure">Média, faculté, association… <span class="facultatif">(facultatif)</span></label>
    <input id="structure" name="Structure" type="text" autocomplete="organization" />
  </div>

  <div class="champ">
    <label for="message">Votre message</label>
    <textarea id="message" name="Message" rows="7" required></textarea>
    <p class="aide" data-aide-conseil hidden>
      Pour une situation de discrimination, ne donnez ici que l'essentiel. Pour un récit détaillé et anonyme, utilisez
      plutôt <a href={url('temoigner')}>le formulaire de témoignage</a>.
    </p>
  </div>

  <div class="champ champ--case">
    <input id="accord" name="Accord" type="checkbox" value="Oui" required />
    <label for="accord">
      J'accepte que mes informations soient utilisées pour répondre à ma demande. Elles ne sont ni publiées ni
      transmises. <a href={url('mentions-legales#confidentialite')}>En savoir plus</a>
    </label>
  </div>

  <div class="contact-form__envoi">
    <button class="bouton" type="submit"><Icone nom="mail" taille={18} /> Envoyer le message</button>
    <p class="contact-form__statut" role="status" aria-live="polite" data-statut></p>
  </div>

  <div class="contact-form__secours" data-secours hidden>
    <p>
      <strong>Votre message n'a pas pu partir depuis le site.</strong> Il n'est pas perdu : envoyez-le depuis votre
      messagerie, il est déjà rédigé.
    </p>
    <div class="boutons">
      <a class="bouton" href="#" data-secours-mail><Icone nom="mail" taille={18} /> Ouvrir ma messagerie</a>
      <button class="bouton bouton--contour" type="button" data-secours-copier>Copier le message</button>
    </div>
    <p class="aide">Adresse du collectif : <strong>{SITE.email}</strong></p>
  </div>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact]');
  if (form) {
    const motif = form.querySelector<HTMLSelectElement>('#motif')!;
    const aide = form.querySelector<HTMLElement>('[data-aide-conseil]');
    const sujet = form.querySelector<HTMLInputElement>('[data-sujet]')!;
    const statut = form.querySelector<HTMLElement>('[data-statut]')!;
    const bouton = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const secours = form.querySelector<HTMLElement>('[data-secours]')!;
    const val = (sel: string) => (form.querySelector<HTMLInputElement>(sel)?.value ?? '').trim();

    const majAide = () => {
      const id = motif.selectedOptions[0]?.dataset.id;
      if (aide) aide.hidden = id !== 'conseil';
    };
    const demande = new URLSearchParams(location.search).get('motif');
    if (demande) {
      const option = [...motif.options].find((o) => o.dataset.id === demande);
      if (option) motif.value = option.value;
    }
    majAide();
    motif.addEventListener('change', majAide);

    // Message de secours : on prépare un e-mail avec le contenu déjà saisi.
    const texteMessage = () =>
      [
        val('#message'),
        '',
        '—',
        `${val('#nom')}${val('#structure') ? ` (${val('#structure')})` : ''}`,
        val('#email'),
      ].join('\n');
    const afficherSecours = () => {
      const lien = form.querySelector<HTMLAnchorElement>('[data-secours-mail]')!;
      lien.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(sujet.value)}&body=${encodeURIComponent(texteMessage())}`;
      secours.hidden = false;
      statut.textContent = '';
    };
    form.querySelector('[data-secours-copier]')?.addEventListener('click', async (e) => {
      const b = e.currentTarget as HTMLButtonElement;
      try {
        await navigator.clipboard.writeText(`À : ${form.dataset.email}\nObjet : ${sujet.value}\n\n${texteMessage()}`);
        b.textContent = 'Message copié !';
      } catch {
        b.textContent = 'Copie impossible';
      }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      sujet.value = `[Site SOS] ${motif.value} – ${val('#nom')}`;
      secours.hidden = true;
      if (!form.dataset.cle) {
        afficherSecours();
        return;
      }
      bouton.disabled = true;
      statut.className = 'contact-form__statut';
      statut.textContent = 'Envoi en cours…';
      try {
        const donnees = Object.fromEntries(new FormData(form));
        delete donnees.redirect;
        const reponse = await fetch(form.dataset.envoi!, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(donnees),
        });
        const json = await reponse.json().catch(() => ({}));
        if (!reponse.ok || json.success !== true) throw new Error(json.body?.message ?? json.message ?? reponse.status);
        form.reset();
        majAide();
        statut.classList.add('contact-form__statut--ok');
        statut.textContent = 'Merci, votre message est bien parti. Nous vous répondons au plus vite.';
      } catch (erreur) {
        console.warn('Envoi du formulaire de contact :', erreur);
        afficherSecours();
      } finally {
        bouton.disabled = false;
      }
    });
  }
</script>
