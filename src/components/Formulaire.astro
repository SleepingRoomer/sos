---
// Formulaire Google Forms intégré.
// Il ne se charge qu'au clic : tant que la personne ne l'a pas affiché, aucune
// connexion n'est faite vers Google (pas de cookie tiers, rien à consentir).
interface Props {
  titre: string;
  url: string;
  hauteur?: number;
  texte?: string;
  bouton?: string;
}
const {
  titre,
  url,
  hauteur = 2400,
  texte = "Le formulaire est hébergé par Google Forms. Il ne s'affiche qu'à votre demande, et ne collecte aucune adresse e-mail automatiquement.",
  bouton = 'Afficher le formulaire',
} = Astro.props;
const embed = `${url}${url.includes('?') ? '&' : '?'}embedded=true`;
const id = `form-${titre.toLowerCase().replace(/[^a-z0-9]+/g, '-').slice(0, 40)}`;
---

<section class="formulaire" aria-labelledby={id} id="formulaire">
  <div class="formulaire__barre">
    <span id={id}>{titre}</span>
    <a href={url} target="_blank" rel="noopener">Ouvrir dans un nouvel onglet ↗</a>
  </div>
  <div class="formulaire__accueil" data-formulaire-accueil>
    <p>{texte}</p>
    <div class="boutons">
      <button class="bouton" type="button" data-formulaire-afficher data-src={embed} data-hauteur={hauteur} data-titre={titre}>
        {bouton}
      </button>
      <a class="bouton bouton--contour" href={url} target="_blank" rel="noopener">Ouvrir sur Google Forms</a>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-formulaire-afficher]').forEach((bouton) => {
    bouton.addEventListener('click', () => {
      const accueil = bouton.closest('[data-formulaire-accueil]');
      if (!accueil) return;
      const iframe = document.createElement('iframe');
      iframe.src = bouton.dataset.src ?? '';
      iframe.title = bouton.dataset.titre ?? 'Formulaire';
      iframe.style.height = `${bouton.dataset.hauteur ?? 2400}px`;
      accueil.replaceWith(iframe);
      iframe.focus();
    });
  });
</script>
