---
import Base from '../layouts/Base.astro';
import { url } from '../utils';
---

<Base titre="Page introuvable">
  <section class="section">
    <div class="conteneur-texte">
      <h1><span class="filets">Page introuvable</span></h1>
      <p class="chapo">Cette page n'existe pas ou a été déplacée.</p>
      <div class="boutons">
        <a class="bouton" href={url()}>Retour à l'accueil</a>
        <a class="bouton bouton--contour" href={url('temoigner')}>Témoigner</a>
      </div>
    </div>
  </section>
</Base>

<script is:inline>
  // Anciennes adresses (sleepingroomer.github.io/sos/…) : redirige vers la même page à la racine.
  if (location.pathname.startsWith('/sos/') || location.pathname === '/sos') {
    location.replace(location.pathname.replace(/^\/sos/, '') || '/');
  }
</script>
