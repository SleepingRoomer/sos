---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Partage from '../../components/Partage.astro';
import { dateFr, isoDate, url } from '../../utils';

export async function getStaticPaths() {
  const ressources = await getCollection('ressources', ({ data }) => !data.brouillon);
  return ressources.map((entree) => ({ params: { slug: entree.id }, props: { entree } }));
}

const { entree } = Astro.props;
const { Content } = await render(entree);
const d = entree.data;
---

<Base titre={d.titre} description={d.resume}>
  <article>
    <header class="tete-page">
      <div class="conteneur-texte">
        <p class="fil"><a href={url('ressources')}>← Toutes les ressources</a></p>
        <div class="article-meta">
          <span class="etiquette">{d.type}</span>
          <span>Mis à jour le <time datetime={isoDate(d.date)}>{dateFr(d.date)}</time></span>
        </div>
        <h1 style="font-size:clamp(1.8rem,4vw,2.7rem)"><span class="filets">{d.titre}</span></h1>
        <p class="chapo">{d.resume}</p>
        {d.public && <p><strong>Pour qui :</strong> {d.public}</p>}
        {
          (d.fichier || d.lien) && (
            <div class="boutons" style="margin-top:1.5rem">
              {d.fichier && (
                <a class="bouton" href={url(d.fichier)} download>
                  Télécharger le document
                </a>
              )}
              {d.lien && (
                <a class="bouton bouton--contour" href={d.lien} rel="noopener">
                  Voir la ressource ↗
                </a>
              )}
            </div>
          )
        }
      </div>
    </header>
    <div class="section" style="padding-top:2.5rem">
      <div class="conteneur-texte prose">
        <Content />
        <Partage titre={d.titre} />
      </div>
    </div>
  </article>
</Base>
