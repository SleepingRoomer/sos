---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import FormulaireContact from '../../components/FormulaireContact.astro';
import Icone from '../../components/Icone.astro';
import { SITE } from '../../config';
import { url } from '../../utils';
---

<Base titre="Contact" description="Contacter le collectif Soigner ou Saigner : presse, interventions, partenariats, questions.">
  <PageHeader
    surtitre="Nous écrire"
    titre="Contact"
    chapo="Presse, demande d'intervention, partenariat ou simple question : écrivez-nous, nous répondons au plus vite."
  />

  <section class="section section--pale">
    <div class="conteneur contact-grille">
      <FormulaireContact />

      <aside class="contact-aside" aria-label="Autres moyens de nous joindre">
        <a class="contact-carte contact-carte--rouge" href={url('temoigner')} style="text-decoration:none;color:inherit">
          <span class="picto picto--rouge"><Icone nom="ecoute" /></span>
          <div>
            <h3>Vous vivez une situation ?</h3>
            <p>Témoignez avec notre formulaire anonyme, et demandez à être recontacté·e si vous le souhaitez.</p>
          </div>
        </a>
        <a class="contact-carte" href={url('nous-rejoindre')} style="text-decoration:none;color:inherit">
          <span class="picto"><Icone nom="groupe" /></span>
          <div>
            <h3>Rejoindre le collectif</h3>
            <p>Remplissez le formulaire d'adhésion : nous vous recontactons.</p>
          </div>
        </a>
        <div class="contact-carte">
          <span class="picto picto--pale"><Icone nom="mail" /></span>
          <div>
            <h3>Par e-mail</h3>
            <p>
              <strong>{SITE.email}</strong><br />
              <button class="bouton-texte" type="button" data-copier-email={SITE.email}>Copier l'adresse</button>
            </p>
          </div>
        </div>
        <a class="contact-carte" href={SITE.instagram.url} rel="noopener" style="text-decoration:none;color:inherit">
          <span class="picto picto--pale"><Icone nom="bulle" /></span>
          <div>
            <h3>Sur Instagram</h3>
            <p>{SITE.instagram.pseudo}, en message privé.</p>
          </div>
        </a>
      </aside>
    </div>
  </section>
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copier-email]').forEach((b) => {
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.copierEmail ?? '');
        b.textContent = 'Adresse copiée !';
      } catch {
        window.prompt("Copiez l'adresse :", b.dataset.copierEmail ?? '');
      }
    });
  });
</script>
