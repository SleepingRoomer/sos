---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Icone from '../components/Icone.astro';
import { SITE } from '../config';
import { url } from '../utils';

// Structures de confiance vers lesquelles le collectif oriente.
// Coordonnées vérifiées en novembre 2026 : à relire de temps en temps.
type Lien = { label: string; href: string };
const partenaires: {
  sigle: string;
  nom: string;
  theme: string;
  icone: 'ecoute' | 'formation' | 'groupe' | 'coeur' | 'soutien' | 'juridique';
  texte: string;
  liens: Lien[];
}[] = [
  {
    sigle: 'CCIE',
    nom: "Collectif contre l'islamophobie en Europe",
    theme: 'Islamophobie',
    icone: 'soutien',
    texte:
      "Accompagne gratuitement les victimes d'islamophobie. Victime ou témoin, vous pouvez y faire un signalement confidentiel, traité par des juristes.",
    liens: [
      { label: 'Signaler sur ccieurope.org', href: 'https://ccieurope.org/' },
      { label: '+32 2 315 11 10', href: 'tel:+3223151110' },
    ],
  },
  {
    sigle: 'EMF',
    nom: 'Étudiants musulmans de France',
    theme: 'Islamophobie à la fac',
    icone: 'formation',
    texte:
      "Association étudiante présente dans de nombreuses universités, qui défend les droits des étudiant·es. Un relais de proximité si vous êtes visé·e par l'islamophobie pendant vos études.",
    liens: [{ label: 'Trouver une section sur emf-asso.fr', href: 'https://www.emf-asso.fr/nous-contacter-2/' }],
  },
  {
    sigle: 'ASAP',
    nom: 'Assemblée pour des soins antiracistes et populaires',
    theme: 'Racisme en santé',
    icone: 'groupe',
    texte:
      "Collectif de travailleur·ses et d'usager·es du soin qui s'organise contre le racisme en santé, avec des assemblées ouvertes à toutes et tous. Co-auteur du « racistomètre ».",
    liens: [
      { label: 'Instagram @ag_soins_antiracistes', href: 'https://www.instagram.com/ag_soins_antiracistes/' },
      { label: 'Ag_antiracisme_soins@proton.me', href: 'mailto:Ag_antiracisme_soins@proton.me' },
    ],
  },
  {
    sigle: 'ObsMed',
    nom: 'Observatoire féministe des violences médicales',
    theme: 'Violences médicales',
    icone: 'coeur',
    texte:
      'Documente les violences médicales et sexistes, recueille les témoignages et diffuse des outils pour les reconnaître et les dénoncer.',
    liens: [
      { label: 'obs-med.com', href: 'https://www.obs-med.com/' },
      { label: 'Le racistomètre et les ressources', href: 'https://www.obs-med.com/informersensibiliser' },
    ],
  },
  {
    sigle: 'BBG',
    nom: 'Blouses blanches pour Gaza',
    theme: 'Soutien à la Palestine',
    icone: 'ecoute',
    texte:
      'Collectif de soignant·es solidaires de la population palestinienne et de ses soignant·es. À contacter si vous subissez des pressions ou des discriminations liées à votre soutien à la cause palestinienne.',
    liens: [{ label: 'Instagram @blousesblanchesgaza', href: 'https://www.instagram.com/blousesblanchesgaza/' }],
  },
  {
    sigle: 'DDD',
    nom: 'Défenseur des droits',
    theme: 'Recours officiel',
    icone: 'juridique',
    texte:
      "Autorité indépendante. Ses juristes écoutent gratuitement les victimes et témoins de discriminations, et peuvent enquêter ou proposer une médiation.",
    liens: [
      { label: '39 28', href: 'tel:3928' },
      { label: 'antidiscriminations.fr', href: 'https://www.antidiscriminations.fr/' },
    ],
  },
];

// Évite qu'un numéro de téléphone soit coupé en fin de ligne.
const insecable = (t: string) => t.replace(/(\d) (?=\d)/g, '$1 ');
---

<Base
  titre="Où trouver de l'aide"
  description="Discrimination dans le soin : le collectif Soigner ou Saigner vous écoute et vous oriente vers des structures de confiance (CCIE, EMF, ASAP, ObsMed, Blouses blanches pour Gaza, Défenseur des droits)."
>
  <PageHeader
    surtitre="Vous n'êtes pas seul·e"
    titre="Où trouver de l'aide"
    chapo="Soignant·e, étudiant·e ou patient·e : le collectif est là pour vous. Commencez par nous écrire : nous vous écoutons, nous vous conseillons et, si besoin, nous vous orientons vers des structures de confiance."
  />

  <section class="section" aria-labelledby="commencer">
    <div class="conteneur">
      <div class="aide-premier">
        <div>
          <span class="etiquette etiquette--rouge">Le premier réflexe</span>
          <h2 id="commencer">Écrivez au collectif</h2>
          <p>
            Remarques, pressions, convocation, sanction, refus de soins : racontez-nous ce qui s'est passé. Écoute,
            soutien moral, aide juridique au cas par cas : on cherche avec vous la meilleure réponse.
          </p>
          <p><strong>Avant de refuser un ordre de votre hiérarchie, parlez-nous-en.</strong></p>
        </div>
        <ul class="aide-premier__actions">
          <li>
            <a href={url('temoigner')}>
              <span class="picto picto--rouge"><Icone nom="cadenas" /></span>
              <span><strong>Témoigner anonymement</strong>Formulaire de 5 à 10 minutes</span>
            </a>
          </li>
          <li>
            <a href={url('contact?motif=conseil')}>
              <span class="picto"><Icone nom="mail" /></span>
              <span><strong>Demander conseil</strong>Pour une situation en cours</span>
            </a>
          </li>
          <li>
            <a href={SITE.instagram.url} rel="noopener">
              <span class="picto"><Icone nom="bulle" /></span>
              <span><strong>Message sur Instagram</strong>{SITE.instagram.pseudo}</span>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--pale" aria-labelledby="partenaires">
    <div class="conteneur">
      <h2 id="partenaires" class="filets">Des structures de confiance</h2>
      <p class="chapo" style="margin-bottom:2rem">
        Selon votre situation, ces collectifs et institutions peuvent aussi vous accompagner. N'hésitez pas à nous
        demander conseil pour choisir.
      </p>
      <div class="grille grille-3 grille-3-fixe">
        {
          partenaires.map((p, i) => (
            <article class="partenaire">
              <div class="partenaire__tete">
                <span class={`picto${i % 2 ? ' picto--rouge' : ''}`}>
                  <Icone nom={p.icone} taille={26} />
                </span>
                <span class="etiquette">{p.theme}</span>
              </div>
              <h3>
                <span class="partenaire__sigle">{p.sigle}</span>
                {p.nom}
              </h3>
              <p>{p.texte}</p>
              <ul class="partenaire__liens">
                {p.liens.map((l) => (
                  <li>
                    <a href={l.href} rel={l.href.startsWith('http') ? 'noopener' : undefined}>
                      {insecable(l.label)}
                    </a>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" style="padding-block:2.5rem">
    <div class="conteneur-texte">
      <p class="aide-urgence">
        <strong>En cas d'urgence</strong> : danger immédiat, appelez le <a href="tel:112">112</a> ou le
        <a href="tel:17">17</a>. Détresse psychologique, idées suicidaires : le <a href="tel:3114">31&nbsp;14</a>,
        gratuit, 24 h/24.
      </p>
      <p class="aide">
        Informations vérifiées en novembre 2026. Une coordonnée a changé ?
        <a href={url('contact?motif=autre')}>Signalez-le-nous</a>.
      </p>
    </div>
  </section>
</Base>
