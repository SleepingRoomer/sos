---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Partage from '../../components/Partage.astro';
import { SITE } from '../../config';
import { dateFr, isoDate, url } from '../../utils';

export async function getStaticPaths() {
  const actions = await getCollection('actions', ({ data }) => !data.brouillon);
  return actions.map((entree) => ({ params: { slug: entree.id }, props: { entree } }));
}

const { entree } = Astro.props;
const { Content } = await render(entree);
const d = entree.data;
const visuel = d.visuel ?? d.image;
---

<Base titre={d.titre} description={d.resume} image={visuel?.replace(/^\//, '')}>
  <article>
    <header class="tete-page">
      <div class="conteneur">
        <p class="fil"><a href={url('actions')}>← Toutes les actions</a></p>
        <div class="article-meta">
          <span class="etiquette">{d.type}</span>
          <time datetime={isoDate(d.date)}>{dateFr(d.date)}</time>
        </div>
        <h1 style="font-size:clamp(1.8rem,4vw,2.7rem);max-width:28ch"><span class="filets">{d.titre}</span></h1>
        <p class="chapo">{d.resume}</p>
      </div>
    </header>
    <div class="section" style="padding-top:2.5rem">
      <div class={`conteneur ${visuel ? 'article-grille' : ''}`}>
        <div class="prose" style="max-width:72ch">
          <Content />
          {
            d.lien && (
              <p style="margin-top:2rem">
                <a class="bouton bouton--contour" href={d.lien} rel="noopener">
                  {d.lienTexte ?? 'Voir la publication'} ↗
                </a>
              </p>
            )
          }
          <Partage titre={d.titre} />
        </div>
        {
          visuel && (
            <figure class="article-visuel">
              <a href={d.lien ?? SITE.instagram.url} rel="noopener">
                <img src={url(visuel)} alt={d.imageAlt ?? `Visuel : ${d.titre}`} width="400" height="500" />
              </a>
              <figcaption>Le visuel sur Instagram : {SITE.instagram.pseudo}</figcaption>
            </figure>
          )
        }
      </div>
    </div>
  </article>
</Base>
